speed = 2
depth = -998

a = 20

dir = irandom(1)

definir_direcao = function(){

	if dir = 1{
		if irandom(1) = 1 direction = irandom_range(a, a*2)-a
		else direction = irandom_range(-a, -a*2)-a
	}
	else{
		if irandom(1) = 1 direction = irandom_range(180+a, 180+a*2)-a
		else direction = irandom_range(180-a, 180-a*2)-a
	}

}

definir_direcao()